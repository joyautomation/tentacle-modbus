{
  "tasks": {
    "dev": "deno run --env-file=.env --watch --allow-all main.ts",
    "start": "deno run --allow-net --allow-env main.ts",
    "test": "deno test --allow-net --allow-env tests/",
    "test:unit": "deno test --allow-net --allow-env tests/protocol_test.ts tests/decode_test.ts tests/blocks_test.ts",
    "test:integration": "deno test --allow-net --allow-env tests/functions_test.ts tests/integration_test.ts",
    "test:smoke": "deno test --allow-net --allow-env tests/pymodbus_smoke_test.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@joyautomation/coral": "jsr:@joyautomation/coral@^0.0.12",
    "@nats-io/transport-deno": "jsr:@nats-io/transport-deno@3",
    "@nats-io/jetstream": "jsr:@nats-io/jetstream@3",
    "@nats-io/kv": "jsr:@nats-io/kv@3",
    "@tentacle/nats-schema": "../tentacle-nats-schema/src/mod.ts"
  },
  "compilerOptions": {
    "strict": true
  }
}
